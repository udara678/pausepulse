# ══════════════════════════════════════════════════════════════
# PausePulse Environment Configuration (.env)
# ══════════════════════════════════════════════════════════════

# ─── Environment & Server ──────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://pausepulse.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# ─── Authentication & Security ────────────────────────────
# CRITICAL: Generate a strong, 64-character random secret for production!
# e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_strong_production_jwt_secret_key_minimum_32_chars

# ─── Stripe Payments & Webhooks ───────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_PRICE_ID_MONTHLY=price_monthly_id_here
STRIPE_PRICE_ID_YEARLY=price_yearly_id_here
STRIPE_PRICE_ID_TEAM=price_team_id_here

# ─── Email Dispatcher (Resend.com) ─────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ─── Database ──────────────────────────────────────────────
# SQLite for local development:
DATABASE_URL=file:./dev.db
# PostgreSQL for production (e.g. Supabase or Neon.tech):
# DATABASE_URL=postgresql://user:secure_password@host:5432/pausepulse?sslmode=require
