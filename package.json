{
  "name": "pausepulse-desktop",
  "version": "1.0.0",
  "description": "PausePulse - Work-Rest Pacing & Ergonomic Health SaaS",
  "main": "dist-electron/main.js",
  "author": "PausePulse Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:electron": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.electron.json",
    "build:ui": "vite build",
    "build:server": "node ./node_modules/typescript/lib/tsc.js -p server/tsconfig.json",
    "build": "npm run build:electron && npm run build:ui && npm run build:server",
    "server": "npx tsx server/src/index.ts",
    "electron:dev": "concurrently \"vite\" \"node ./node_modules/typescript/lib/tsc.js -p tsconfig.electron.json --watch\" \"electron .\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
